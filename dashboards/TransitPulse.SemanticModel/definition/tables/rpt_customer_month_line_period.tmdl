table rpt_customer_month_line_period
	lineageTag: 8b545f4f-b509-4ef5-b1f5-c5b6c12bd7fc

	measure 'Passenger Trips' = SUM ( 'rpt_customer_month_line_period'[passenger_trips] )
		formatString: #,0
		lineageTag: d6d2e1c0-8ad3-4b2a-9924-ee25987c1e3b

	measure 'Trips Over Five Minutes' = SUM ( 'rpt_customer_month_line_period'[over_five_trips] )
		formatString: #,0
		lineageTag: ed85d967-6970-470c-bc2a-1b582693c602

	measure 'CJTP %' =
			IF (
			    [Passenger Trips] > 0,
			    1 - DIVIDE ( [Trips Over Five Minutes], [Passenger Trips] )
			)
		formatString: 0.00%
		lineageTag: abe408df-d266-44fb-90f4-89d9d946cfda

	measure 'Platform Minutes' = SUM ( 'rpt_customer_month_line_period'[platform_minutes] )
		formatString: #,0
		lineageTag: 20cfe8d4-27b3-454f-a9a4-1c5b6c385622

	measure 'Train Minutes' = SUM ( 'rpt_customer_month_line_period'[train_minutes] )
		formatString: #,0
		lineageTag: 47bb918f-5ca9-4334-9ab8-7b3ca38678a6

	measure 'Net Additional Passenger Minutes' = [Platform Minutes] + [Train Minutes]
		formatString: #,0
		lineageTag: 53988c53-76eb-405f-9a60-210307b79059

	measure 'APT Minutes Per Trip' = DIVIDE ( [Platform Minutes], [Passenger Trips] )
		formatString: 0.00
		lineageTag: 47841eb0-88c5-4405-928b-02bf6361d483

	measure 'ATT Minutes Per Trip' = DIVIDE ( [Train Minutes], [Passenger Trips] )
		formatString: 0.00
		lineageTag: 5c3dbd54-f9e6-4392-933c-3fa82e958148

	measure 'AJT Minutes Per Trip' = DIVIDE ( [Net Additional Passenger Minutes], [Passenger Trips] )
		formatString: 0.00
		lineageTag: e95eea67-b49b-49c2-b316-6e17f045375c

	measure 'Previous Year CJTP %' =
			VAR SelectedYear = SELECTEDVALUE ( 'rpt_dim_month'[year] )
			RETURN
			    IF (
			        NOT ISBLANK ( SelectedYear ) && NOT ISFILTERED ( 'rpt_dim_month'[month] ),
			        CALCULATE (
			            [CJTP %],
			            REMOVEFILTERS ( 'rpt_dim_month' ),
			            'rpt_dim_month'[year] = SelectedYear - 1
			        )
			    )
		formatString: 0.00%
		lineageTag: 67de1e5c-2968-4f3d-90a9-4cbece2714c4

	measure 'CJTP YoY Change pp' =
			IF (
			    HASONEVALUE ( 'rpt_dim_month'[year] ) && NOT ISFILTERED ( 'rpt_dim_month'[month] ),
			    100 * ( [CJTP %] - [Previous Year CJTP %] )
			)
		formatString: +0.00;-0.00;0.00
		lineageTag: 10dc74c2-44d3-4202-9bef-c9808d58481a

	measure '2025 vs 2022 System CJTP pp' =
			IF (
			    SELECTEDVALUE ( 'rpt_dim_month'[year] ) = 2025
			        && NOT ISFILTERED ( 'rpt_dim_line'[line_id] )
			        && NOT ISFILTERED ( 'rpt_dim_month'[month] ),
			    100 * (
			        CALCULATE ( [CJTP %], REMOVEFILTERS ( 'rpt_dim_month' ), 'rpt_dim_month'[year] = 2025 )
			        - CALCULATE ( [CJTP %], REMOVEFILTERS ( 'rpt_dim_month' ), 'rpt_dim_month'[year] = 2022 )
			    )
			)
		formatString: +0.00;-0.00;0.00
		lineageTag: 12e31a1a-a8cb-486e-a185-ee7930ff0666

	measure 'Weekday Delay Incidents' =
			CALCULATE (
			    SUM ( 'rpt_delay_month_line_category'[delay_incidents] ),
			    'rpt_delay_month_line_category'[day_type] = 1
			)
		formatString: #,0
		lineageTag: be1c7473-f3ea-414a-8468-769ed501e841

	measure 'Weekday Delay Coverage Months' =
			CALCULATE (
			    DISTINCTCOUNT ( 'rpt_delay_month_line_category'[month] ),
			    'rpt_delay_month_line_category'[day_type] = 1
			)
		formatString: #,0
		lineageTag: c14b2cca-26ed-417b-b811-0618252e4d26

	measure 'Weekday Major Incidents' =
			CALCULATE (
			    SUM ( 'rpt_major_month_line_category'[major_incidents] ),
			    'rpt_major_month_line_category'[day_type] = 1
			)
		formatString: #,0
		lineageTag: 3d8c6852-5060-4b67-9a6f-d0ab5b6cbb74

	measure 'Weekday Peak Scheduled Trains' =
			CALCULATE (
			    SUM ( 'rpt_service_month_line_daytype'[scheduled_peak_trains] ),
			    'rpt_service_month_line_daytype'[day_type] = 1
			)
		formatString: #,0
		lineageTag: 1e33fe4a-4811-4607-b1d9-ab69f0e437c8

	measure 'Weekday Peak Actual Trains' =
			CALCULATE (
			    SUM ( 'rpt_service_month_line_daytype'[actual_peak_trains] ),
			    'rpt_service_month_line_daytype'[day_type] = 1
			)
		formatString: #,0
		lineageTag: 3fd36ebe-4486-4ce1-86ba-9bfd3a1c5e15

	measure 'Weekday Peak Service Delivered %' = DIVIDE ( [Weekday Peak Actual Trains], [Weekday Peak Scheduled Trains] )
		formatString: 0.00%
		lineageTag: 6f106648-ac70-40cc-ab4c-7063fd049a55

	measure '2025 Priority Score' =
			IF (
			    NOT ISFILTERED ( 'rpt_dim_month'[year] )
			        && NOT ISFILTERED ( 'rpt_dim_month'[month] ),
			    MAX ( 'rpt_priority_2025'[score_baseline] )
			)
		formatString: 0.0
		lineageTag: 855d6a3c-0e92-462d-8988-ba079bde8368

	measure '2025 Priority Rank' =
			IF (
			    NOT ISFILTERED ( 'rpt_dim_month'[year] )
			        && NOT ISFILTERED ( 'rpt_dim_month'[month] ),
			    MIN ( 'rpt_priority_2025'[rank_baseline] )
			)
		formatString: #,0
		lineageTag: 74809797-78dc-4287-833c-d992c725a098

	measure '2025 CJTP %' =
			CALCULATE (
			    [CJTP %],
			    REMOVEFILTERS ( 'rpt_dim_month' ),
			    'rpt_dim_month'[year] = 2025
			)
		formatString: 0.00%
		lineageTag: bfed6ba8-6eb3-4e7e-9393-7fc12eff461f

	measure '2025 Net Additional Minutes' =
			CALCULATE (
			    [Net Additional Passenger Minutes],
			    REMOVEFILTERS ( 'rpt_dim_month' ),
			    'rpt_dim_month'[year] = 2025
			)
		formatString: #,0
		lineageTag: 9ce8bb10-1b2c-483e-aeea-d32df7c4e94f

	measure '2025 Priority CJTP %' = MAX ( 'rpt_priority_2025'[cjt_percent] )
		formatString: 0.00
		lineageTag: 46edf1cc-8acf-4f29-bc69-94c9f3a77ce5

	measure '2025 Priority Net Minutes' = SUM ( 'rpt_priority_2025'[net_additional_passenger_minutes] )
		formatString: #,0
		lineageTag: 25176cd4-34c6-4a93-90b5-536399c92901

	measure '2025 Priority Passenger Trips' = MAX ( 'rpt_priority_2025'[passenger_trips] )
		formatString: #,0
		lineageTag: 840d426f-cc1e-441d-ac4d-04a5aedce345

	measure '2025 Reliability Concern Score' = MAX ( 'rpt_priority_2025'[reliability_concern_score] )
		formatString: 0.0
		lineageTag: 6809727a-f478-4dd3-8493-abdec7fe4bd2

	measure '2025 Passenger Burden Score' = MAX ( 'rpt_priority_2025'[passenger_burden_score] )
		formatString: 0.0
		lineageTag: 57c144d3-2fc3-472f-9da8-9a97ca450f95

	measure '2025 Operational Risk Score' = MAX ( 'rpt_priority_2025'[operational_risk_score] )
		formatString: 0.0
		lineageTag: 5b5ec64f-e20a-4f8e-8630-c91671f18c4b

	measure '2025 Net Minutes (billions)' = DIVIDE ( [2025 Net Additional Minutes], 1000000000 )
		formatString: 0.00"B"
		lineageTag: 8936c759-c1d3-414f-949f-e5e7cee3d5bd

	measure 'Net Additional Passenger Minutes (M)' = DIVIDE ( [Net Additional Passenger Minutes], 1000000 )
		formatString: 0.0
		lineageTag: 46271fad-0549-4019-a8ed-08335eda3e81

	measure '2025 Priority Net Minutes (M)' = DIVIDE ( [2025 Priority Net Minutes], 1000000 )
		formatString: 0.0
		lineageTag: 4ac92e6d-957c-4b7b-ba52-c5ea87b1e817

	column month
		dataType: dateTime
		formatString: Long Date
		lineageTag: b3b57bf6-f2bb-4bed-a52d-4b0d9ed3d2e7
		summarizeBy: none
		sourceColumn: month

		annotation UnderlyingDateTimeDataType = Date

	column line_id
		dataType: string
		lineageTag: 5b6eae25-3b9e-4e9b-9bc2-bffb18b8f5f8
		summarizeBy: none
		sourceColumn: line_id

	column period
		dataType: string
		lineageTag: c20aa870-e4e2-41b5-801e-ac899e43ad1f
		summarizeBy: none
		sourceColumn: period

	column passenger_trips
		dataType: double
		isHidden
		lineageTag: 497dc1c5-1f1a-4873-8d8d-d8f45e75bd40
		summarizeBy: none
		sourceColumn: passenger_trips

	column over_five_trips
		dataType: double
		isHidden
		lineageTag: b0afa819-6fcd-4eb9-b6a5-11348531400d
		summarizeBy: none
		sourceColumn: over_five_trips

	column platform_minutes
		dataType: double
		isHidden
		lineageTag: 29bba0a3-293e-404b-a920-8870b61cf3b8
		summarizeBy: none
		sourceColumn: platform_minutes

	column train_minutes
		dataType: double
		isHidden
		lineageTag: 7586ab5f-f0ac-4fdc-aec7-dbe62984d6df
		summarizeBy: none
		sourceColumn: train_minutes

	column net_additional_passenger_minutes
		dataType: double
		isHidden
		lineageTag: ce8dac32-9236-4aaa-b920-8d004293defa
		summarizeBy: none
		sourceColumn: net_additional_passenger_minutes

